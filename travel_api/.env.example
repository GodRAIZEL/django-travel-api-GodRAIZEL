# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set USE_POSTGRES=True and fill these in for PostgreSQL; otherwise SQLite is used.
USE_POSTGRES=False
DB_NAME=travel_api
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

MAX_UPLOAD_SIZE_MB=5
LOG_LEVEL=INFO
